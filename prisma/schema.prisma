model usuario {
  usuario_id          Int         @id @default(autoincrement())
  nome                String      @db.VarChar(150)
  cpf                 String      @unique @db.Char(11)
  email               String      @unique @db.VarChar(150)
  senha               String      @db.VarChar(550)
  cargo_id            Int
  ativo               Boolean     @default(true)
  data_hora_inclusao  DateTime    @default(now()) @db.Timestamp(6)
  data_hora_alteracao DateTime    @default(now()) @db.Timestamp(6)
  permissao           permissao[]
  cargo               cargo       @relation(fields: [cargo_id], references: [cargo_id], map: "fk_usuario_cargo")
}

model licitacao {
  licitacao_id Int @id @default(autoincrement())
  secretaria_id Int?

  numero     String @unique @db.VarChar(50)
  objeto     String @db.VarChar(300)
  modalidade String @db.VarChar(100)

  valor_estimado Decimal @db.Decimal(15, 2)

  status        String   @db.VarChar(300)
  data_abertura DateTime

  // Relacionamentos
  secretaria secretaria? @relation(fields: [secretaria_id], references: [secretaria_id])

  contratos contrato[]

  // Controle
  ativo               Boolean  @default(true)
  data_hora_inclusao  DateTime @default(now())
  data_hora_alteracao DateTime @updatedAt

  @@index([status])
  @@index([data_abertura])
}

model contrato {
  contrato_id  Int  @id @default(autoincrement())
  licitacao_id Int?

  numero     String @unique @db.VarChar(50)
  objeto     String @db.VarChar(300)
  fornecedor String @db.VarChar(200)

  valor_total   Decimal  @db.Decimal(15, 2)
  data_vigencia DateTime

  status String @db.VarChar(300)

  // Relacionamentos
  licitacao licitacao? @relation(fields: [licitacao_id], references: [licitacao_id])
  empenhos  empenho[]

  // Controle
  ativo               Boolean  @default(true)
  data_hora_inclusao  DateTime @default(now())
  data_hora_alteracao DateTime @updatedAt

  @@index([status])
  @@index([data_vigencia])
}

model empenho {
  empenho_id    Int  @id @default(autoincrement())
  secretaria_id Int
  contrato_id   Int?

  descricao String @db.VarChar(300)

  // Financeiro
  valor      Decimal @db.Decimal(15, 2)
  valor_pago Decimal @default(0) @db.Decimal(15, 2)

  // Datas
  data            DateTime
  data_vencimento DateTime

  // Status
  status String @db.VarChar(300)

  // Classificação
  rubrica        String @db.VarChar(100)
  setor_contabil String @db.VarChar(100)
  projeto        String @db.VarChar(100)
  fonte          String @db.VarChar(100)

  fornecedor String @db.VarChar(200)

  // Relacionamentos
  secretaria secretaria @relation(fields: [secretaria_id], references: [secretaria_id])
  contrato   contrato?  @relation(fields: [contrato_id], references: [contrato_id])

  // Controle
  ativo               Boolean  @default(true)
  data_hora_inclusao  DateTime @default(now())
  data_hora_alteracao DateTime @updatedAt

  @@index([secretaria_id])
  @@index([contrato_id])
  @@index([status])
  @@index([data])
  @@index([data_vencimento])
}

model dado_avulso {
  dado_avulso_id Int @id @default(autoincrement())

  secretaria_id Int?
  tipo          String @db.VarChar(100)
  ano           Int?

  dados Json // JSONB no Postgres

  fonte String? @db.VarChar(200)

  criado_em     DateTime @default(now())
  atualizado_em DateTime @updatedAt

  secretaria secretaria? @relation(fields: [secretaria_id], references: [secretaria_id])

  @@index([tipo])
  @@index([secretaria_id])
  @@index([ano])
}
