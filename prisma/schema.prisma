generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model cargo {
  cargo_id Int @id @default(autoincrement())

  secretaria_id Int?

  nome                String   @db.VarChar(150)
  ativo               Boolean  @default(true)
  data_hora_inclusao  DateTime @default(now()) @db.Timestamp(6)
  data_hora_alteracao DateTime @default(now()) @db.Timestamp(6)

  secretaria secretaria? @relation(fields: [secretaria_id], references: [secretaria_id], map: "fk_cargo_secretaria")

  usuario usuario[]

  // ⚠️ índice ajustado (ver explicação abaixo)
  @@unique([nome], map: "uq_cargo_secretaria_nome")
}

model modulo {
  modulo_id           Int                @id @default(autoincrement())
  nome                String             @unique @db.VarChar(150)
  url                 String             @db.VarChar(150)
  ativo               Boolean            @default(true)
  data_hora_inclusao  DateTime           @default(now()) @db.Timestamp(6)
  data_hora_alteracao DateTime           @default(now()) @db.Timestamp(6)
  permissao_modulo    permissao_modulo[]
}

model permissao {
  permissao_id        Int                @id @default(autoincrement())
  usuario_id          Int
  secretaria_id       Int
  ativo               Boolean            @default(true)
  data_hora_inclusao  DateTime           @default(now()) @db.Timestamp(6)
  data_hora_alteracao DateTime           @default(now()) @db.Timestamp(6)
  secretaria          secretaria         @relation(fields: [secretaria_id], references: [secretaria_id], map: "fk_permissao_secretaria")
  usuario             usuario            @relation(fields: [usuario_id], references: [usuario_id], map: "fk_permissao_usuario")
  permissao_modulo    permissao_modulo[]

  @@unique([usuario_id, secretaria_id], map: "uq_permissao_usuario_secretaria")
}

model permissao_modulo {
  permissao_modulo_id Int       @id @default(autoincrement())
  permissao_id        Int
  modulo_id           Int
  ativo               Boolean   @default(true)
  data_hora_inclusao  DateTime  @default(now()) @db.Timestamp(6)
  data_hora_alteracao DateTime  @default(now()) @db.Timestamp(6)
  modulo              modulo    @relation(fields: [modulo_id], references: [modulo_id], map: "fk_perm_mod_modulo")
  permissao           permissao @relation(fields: [permissao_id], references: [permissao_id], map: "fk_perm_mod_permissao")

  @@unique([permissao_id, modulo_id], map: "uq_permissao_modulo")
}

model prefeitura {
  prefeitura_id       Int          @id @default(autoincrement())
  nome                String       @db.VarChar(200)
  coord_x             Decimal?     @db.Decimal(10, 6)
  coord_y             Decimal?     @db.Decimal(10, 6)
  ativo               Boolean      @default(true)
  data_hora_inclusao  DateTime     @default(now()) @db.Timestamp(6)
  data_hora_alteracao DateTime     @default(now()) @db.Timestamp(6)
  secretaria          secretaria[]
}

model secretaria {
  secretaria_id Int @id @default(autoincrement())
  prefeitura_id Int

  nome      String @db.VarChar(200)
  sigla     String @db.VarChar(20)
  descricao String @db.VarChar(500)
  cor       String @db.VarChar(50)
  icone     String @db.VarChar(50)
  href      String @db.VarChar(200)

  orcamento_total Decimal @db.Decimal(15, 2)
  total_empenhado Decimal @db.Decimal(15, 2)
  total_pago      Decimal @db.Decimal(15, 2)

  risco_orcamentario String @db.VarChar(100)
  risco_divida       String @db.VarChar(100)

  sistema_integrado  String   @db.VarChar(100)
  fonte_dos_dados    String   @db.VarChar(200)
  ultima_atualizacao DateTime @db.Timestamp(6)

  ativo               Boolean  @default(true)
  data_hora_inclusao  DateTime @default(now()) @db.Timestamp(6)
  data_hora_alteracao DateTime @updatedAt @db.Timestamp(6)

  cargo        cargo[]
  permissao    permissao[]
  empenho      empenho[]
  licitacao    licitacao[]    
  dados_anuais secretaria_dados_anuais[]

  dados_avulsos dado_avulso[]

  prefeitura prefeitura @relation(fields: [prefeitura_id], references: [prefeitura_id], map: "fk_secretaria_prefeitura")
}

model secretaria_dados_anuais {
  id            Int @id @default(autoincrement())
  secretaria_id Int

  ano Int
  mes Int

  orcamento_total Decimal @db.Decimal(15, 2)
  total_empenhado Decimal @db.Decimal(15, 2)
  total_pago      Decimal @db.Decimal(15, 2)

  criado_em DateTime @default(now())

  secretaria secretaria @relation(fields: [secretaria_id], references: [secretaria_id])

  @@unique([secretaria_id, ano, mes])
}

model mensagem {
  mensagem_id Int @id @default(autoincrement())

  assunto     String @db.VarChar(150)
  endereco    String @db.VarChar(300)
  cpf         String @db.VarChar(14) // formato: 000.000.000-00
  descricao   String @db.Text

  // Controle
  ativo               Boolean  @default(true)
  data_hora_inclusao  DateTime @default(now())
  data_hora_alteracao DateTime @updatedAt

  @@index([cpf])
  @@index([assunto])
}


